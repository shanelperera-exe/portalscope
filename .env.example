# Backend
PORT=3000
NODE_ENV=development

# Database configuration
POSTGRES_USER=explorer
POSTGRES_PASSWORD=explorer
POSTGRES_DB=interdimensional_explorer
POSTGRES_DB_TEST=interdimensional_explorer_test

# Local development database URL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Docker-compose database URL (uses 'postgres' host)
DOCKER_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

RICK_AND_MORTY_API_URL=https://rickandmortyapi.com/api
RICK_AND_MORTY_API_TIMEOUT=5000
CORS_ORIGIN=http://localhost:5173
ENABLE_TEST_FAILURES=false
APP_VERSION=1.0.0

# Frontend (Vite)
VITE_API_BASE_URL=/api
